---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Tarif Plombier Liège | Devis Gratuit et Prix Transparents | Lynecares" description="Consultez nos tarifs de plomberie à Liège. Devis gratuit, prix débouchage canalisation, tarif horaire plombier transparent. Intervention sans surprise.">
  <Navbar />
  
  <main>
    <section class="page-header" style="background-color: var(--navy); color: white; padding: 150px 0 80px; text-align: center;">
      <div class="container text-center">
        <h1 style="color: white; font-size: 3rem;">Tarif Plombier Liège : Transparence Totale</h1>
        <p style="color: var(--cyan); font-size: 1.2rem;">Prix clairs, devis gratuit et aucune mauvaise surprise pour trouver un <strong>plombier pas cher à Liège</strong> sans compromis sur la qualité.</p>
      </div>
    </section>

    <section class="container py-5">
      <h2 class="section-title text-center mb-5">Grille Tarifaire Plomberie & Chauffage</h2>
      <div class="glass p-5">
        <p class="text-center mb-4">Chez Lynecares, la confiance commence par des <strong>tarifs honnêtes et transparents</strong>. Quel est le <strong>coût d'intervention d'un plombier à Liège</strong> ? Voici notre grille de <strong>prix plombier Liège</strong> indicative (hors pièces).</p>
        
        <div style="overflow-x:auto;">
          <table style="width: 100%; border-collapse: collapse; margin-bottom: 30px; text-align: left;">
            <thead>
              <tr style="background-color: var(--navy); color: white;">
                <th style="padding: 15px; border: 1px solid #e2e8f0;">Prestation</th>
                <th style="padding: 15px; border: 1px solid #e2e8f0;">Tarif TVAC (6%)</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td style="padding: 15px; border: 1px solid #e2e8f0;"><strong>Tarif horaire plombier Liège</strong> (Main d'œuvre en journée)</td>
                <td style="padding: 15px; border: 1px solid #e2e8f0;">À partir de 65 € / heure</td>
              </tr>
              <tr style="background-color: #f8fafc;">
                <td style="padding: 15px; border: 1px solid #e2e8f0;"><strong>Frais de déplacement</strong> (Liège et grande couronne)</td>
                <td style="padding: 15px; border: 1px solid #e2e8f0;">45 €</td>
              </tr>
              <tr>
                <td style="padding: 15px; border: 1px solid #e2e8f0;"><strong>Prix débouchage canalisation Liège</strong> (Mécanique ou Haute pression)</td>
                <td style="padding: 15px; border: 1px solid #e2e8f0;">Forfait à partir de 140 €</td>
              </tr>
              <tr style="background-color: #f8fafc;">
                <td style="padding: 15px; border: 1px solid #e2e8f0;"><strong>Entretien chaudière gaz</strong> (Obligatoire)</td>
                <td style="padding: 15px; border: 1px solid #e2e8f0;">Forfait à partir de 135 €</td>
              </tr>
              <tr>
                <td style="padding: 15px; border: 1px solid #e2e8f0;"><strong>Devis gratuit plomberie Liège</strong> (Rénovation Salle de bain, Installation)</td>
                <td style="padding: 15px; border: 1px solid #e2e8f0;">Gratuit</td>
              </tr>
            </tbody>
          </table>
        </div>

        <div class="alert mt-4" style="background-color: #fff3cd; color: #856404; padding: 15px; border-radius: 8px;">
          <strong>Majoration de nuit et week-end :</strong> En cas de <strong>plombier d'urgence à Liège</strong> le soir (après 18h), les week-ends ou jours fériés, une majoration légale de 50% à 100% s'applique sur la main d'œuvre. Le technicien vous confirmera le tarif exact avant de se déplacer.
        </div>
      </div>
    </section>

    <section class="cta py-5 text-center">
      <div class="container glass" style="padding: 40px; background: linear-gradient(135deg, var(--navy), #2a4175); color: white;">
        <h2 style="color: white;">Besoin d'un devis plombier à Liège ?</h2>
        <p>Demandez votre <strong>devis gratuit</strong> dès aujourd'hui. Un artisan plombier sérieux vous répond dans les plus brefs délais.</p>
        <a href="/contact" class="btn-primary" style="background-color: var(--orange); padding: 15px 30px; font-size: 1.2rem; margin-top: 20px; display: inline-block;">Demander un devis gratuit</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @import '../styles/global.css';
</style>
