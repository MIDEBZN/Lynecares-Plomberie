---
import LpLayout from '../../layouts/LpLayout.astro';
import LandingPageTemplate from '../../components/lp/LandingPageTemplate.astro';
import { LP_SERVICES } from '../../data/lpConfig';

const config = LP_SERVICES['debouchage-liege'];
---

<LpLayout
  title={config.metaTitle}
  description={config.metaDescription}
  canonicalPath={config.canonicalPath}
  serviceCategory={config.serviceCategory}
  phoneDisplay={config.phoneNumberDisplay}
  phoneTel={config.phoneNumberTel}
  whatsappUrl={config.whatsappUrl}
  persistentBarCtaText={config.persistentBarCtaText}
>
  <LandingPageTemplate config={config} />
</LpLayout>
