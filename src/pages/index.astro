---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Plombier Liège 24h/24 | Dépannage rapide | Lynecares" description="Besoin d’un plombier à Liège ? Dépannage, fuite, débouchage, sanitaire et chauffage. Appelez Lynecares au 0466 26 58 95." preloadImage="https://images.unsplash.com/photo-1585704032915-c3400ca199e7?ixlib=rb-4.0.3&fm=webp&fit=crop&w=2070&q=80">
  <Navbar />
  
  <main>
    <section class="hero" style="background: linear-gradient(rgba(27, 42, 74, 0.75), rgba(27, 42, 74, 0.85)), url('https://images.unsplash.com/photo-1585704032915-c3400ca199e7?ixlib=rb-4.0.3&fm=webp&fit=crop&w=2070&q=80') center/cover;">
      <div class="hero-overlay"></div>
      <div class="container hero-content">
        <div class="glass hero-box">
          <span class="badge">Artisan Plombier à Liège</span>
          <h1>Plombier à Liège <span class="highlight">24h/24 et 7j/7</span></h1>
          <p class="hero-intro">Dépannage d'urgence, fuite d'eau, débouchage, sanitaire et chauffage. Une intervention rapide et des prix transparents dans toute la région liégeoise.</p>
          
          <!-- DIRECT-ANSWER BLOCK -->
          <div class="direct-answer-box glass mb-4">
            <div class="answer-grid">
              <div class="answer-item">
                <span class="answer-label">🛠️ Services :</span>
                <span class="answer-val">Dépannage 24/7, fuite d'eau, débouchage, installation sanitaire, chauffe-eau & chaudière</span>
              </div>
              <div class="answer-item">
                <span class="answer-label">📍 Zone couverte :</span>
                <span class="answer-val">Liège (4000, 4020, 4030), Seraing, Herstal, Ans, Chaudfontaine et province</span>
              </div>
              <div class="answer-item">
                <span class="answer-label">⏱️ Délai d'arrivée :</span>
                <span class="answer-val">Environ 30 minutes selon disponibilité et localisation</span>
              </div>
              <div class="answer-item">
                <span class="answer-label">💶 Tarifs & Devis :</span>
                <span class="answer-val">Devis gratuit et transparent avant chaque intervention, aucun frais caché</span>
              </div>
              <div class="answer-item">
                <span class="answer-label">🕒 Permanence :</span>
                <span class="answer-val">Ligne d'urgence active 24h/24 et 7j/7 au <strong>0466 26 58 95</strong></span>
              </div>
            </div>
          </div>

          <div class="hero-btns">
            <a href="tel:0466265895" class="btn-primary call-btn">☎ Appeler le 0466 26 58 95</a>
            <a href="/contact/" class="btn-secondary">Demander un Devis Gratuit</a>
          </div>
        </div>
      </div>
    </section>

    <section class="features container py-5">
      <div class="feature-card glass">
        <div class="icon">🚀</div>
        <h3>Réactivité Locale</h3>
        <p>Intervention rapide (environ 30 min selon localisation) à Liège et environs.</p>
      </div>
      <div class="feature-card glass">
        <div class="icon">🏆</div>
        <h3>Savoir-Faire Artisanal</h3>
        <p>Une expertise reconnue dans les installations sanitaires et de chauffage.</p>
      </div>
      <div class="feature-card glass">
        <div class="icon">💶</div>
        <h3>Prix Transparents</h3>
        <p>Devis gratuit et tarifs clairs avant chaque intervention. Pas de surprise.</p>
      </div>
    </section>

    <section class="services-preview py-5">
      <div class="container">
        <h2 class="section-title">Nos Services de Plomberie à Liège</h2>
        <div class="services-grid">
          <div class="service-item glass">
            <h3>🚨 Dépannage Urgence</h3>
            <p>Fuite d'eau, canalisation bouchée, panne de chauffe-eau. Nous intervenons rapidement pour sécuriser votre installation.</p>
            <a href="/services/urgences-plomberie/" class="read-more">Dépannage urgence plombier Liège &rarr;</a>
          </div>
          <div class="service-item glass">
            <h3>🛁 Rénovation Salle de Bain</h3>
            <p>Conception et pose complète de salle de bain clé en main : douche italienne, baignoire, meubles et carrelage.</p>
            <a href="/services/renovation-salle-de-bain-liege/" class="read-more">Rénovation salle de bain Liège &rarr;</a>
          </div>
          <div class="service-item glass">
            <h3>🔥 Chauffagiste & Chaudière</h3>
            <p>Dépannage, réparation et installation de chaudières toutes marques (gaz et mazout). Chauffagistes certifiés.</p>
            <a href="/services/chauffagiste-liege/" class="read-more">Chauffagiste & dépannage chaudière Liège &rarr;</a>
          </div>
          <div class="service-item glass">
            <h3>🌪️ Débouchage Canalisations</h3>
            <p>Débouchage haute pression pour WC, éviers, douches et égouts extérieurs avec inspection caméra.</p>
            <a href="/services/debouchage/" class="read-more">Débouchage de canalisation Liège &rarr;</a>
          </div>
          <div class="service-item glass">
            <h3>🔧 Installation Sanitaire</h3>
            <p>Pose de WC suspendus, remplacement de robinetterie, raccordement de boiler et nouvelles arrivées d'eau.</p>
            <a href="/services/installations-sanitaires/" class="read-more">Installation sanitaire Liège &rarr;</a>
          </div>
          <div class="service-item glass">
            <h3>⚙️ Entretien Préventif</h3>
            <p>Détartrage de chauffe-eau, désembouage de radiateurs et contrôles d'étanchéité pour prévenir les pannes.</p>
            <a href="/services/entretien-plomberie-chauffage/" class="read-more">Entretien chauffage & boiler Liège &rarr;</a>
          </div>
        </div>
        <div class="text-center mt-5">
          <a href="/services/" class="btn-secondary">Consulter l'ensemble de nos services</a>
        </div>
      </div>
    </section>

    <!-- TRUST & STATS SECTION -->
    <section class="trust-stats py-5">
      <div class="container">
        <div class="stats-grid">
          <div class="stat-box glass">
            <span class="stat-number">~30<small>min</small></span>
            <span class="stat-label">Délai estimé selon disponibilité</span>
          </div>
          <div class="stat-box glass">
            <span class="stat-number">Pro<small>+</small></span>
            <span class="stat-label">Techniciens qualifiés</span>
          </div>
          <div class="stat-box glass">
            <span class="stat-number">100<small>%</small></span>
            <span class="stat-label">Devis respectés, sans surprise</span>
          </div>
          <div class="stat-box glass">
            <span class="stat-number">24<small>/7</small></span>
            <span class="stat-label">Astreinte téléphonique</span>
          </div>
        </div>
        
        <div class="certifications-banner mt-5 glass text-center">
          <h3>Nos Agréments & Garanties</h3>
          <div class="cert-logos">
            <div class="cert-item">
              <span class="cert-icon">🛡️</span>
              <span>Agréé Assurances</span>
            </div>
            <div class="cert-item">
              <span class="cert-icon">🔥</span>
              <span>Agréé Cerga (Gaz)</span>
            </div>
            <div class="cert-item">
              <span class="cert-icon">🛢️</span>
              <span>Cédicol (Mazout)</span>
            </div>
            <div class="cert-item">
              <span class="cert-icon">✅</span>
              <span>Entreprise Enregistrée</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS SECTION -->
    <section class="testimonials py-5 bg-light">
      <div class="container">
        <div class="text-center mb-5">
          <h2 class="section-title">Avis de Nos Clients à Liège et Province</h2>
          <div class="stars" style="color: #fbbf24; font-size: 1.5rem;">★★★★★</div>
          <p>Témoignages de nos clients pour des interventions réalisées en province de Liège.</p>
        </div>
        
        <div class="testimonials-grid">
          <div class="review-card glass">
            <div class="review-header">
              <div class="avatar">M</div>
              <div>
                <strong>Marc D. (Liège, Quartier Outremeuse)</strong>
                <div class="stars" style="color: #fbbf24;">★★★★★</div>
              </div>
            </div>
            <p>"Intervention rapide pour une rupture de canalisation dans ma cave un dimanche. Le technicien a immédiatement sécurisé l'installation électrique avant de colmater la fuite. Facture conforme au devis. Merci !"</p>
            <span class="review-service">Service : Dépannage Urgence</span>
          </div>
          
          <div class="review-card glass">
            <div class="review-header">
              <div class="avatar">S</div>
              <div>
                <strong>Sophie L. (Seraing)</strong>
                <div class="stars" style="color: #fbbf24;">★★★★★</div>
              </div>
            </div>
            <p>"Très professionnels. Ils ont utilisé une caméra pour trouver un bouchon récalcitrant dans mes canalisations sans devoir tout casser. Travail propre et rapide."</p>
            <span class="review-service">Service : Débouchage Caméra</span>
          </div>
          
          <div class="review-card glass">
            <div class="review-header">
              <div class="avatar">J</div>
              <div>
                <strong>Jean-Pol (Chaudfontaine)</strong>
                <div class="stars" style="color: #fbbf24;">★★★★★</div>
              </div>
            </div>
            <p>"Remplacement complet de notre vieille chaudière. Conseils excellents sur le choix du modèle, installation soignée et chantier laissé parfaitement propre."</p>
            <span class="review-service">Service : Installation Chauffage</span>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICE MAP AREA -->
    <section class="service-map py-5">
      <div class="container">
        <div class="map-flex glass">
          <div class="map-content">
            <h2>Notre Zone d'Intervention à Liège et Province</h2>
            <p>Notre position stratégique nous permet de couvrir l'ensemble de la province de Liège avec rapidité. Consultez notre <a href="/locations/">liste complète des communes</a>.</p>
            <ul class="area-list mt-3">
              <li><span class="text-cyan">📍</span> <strong>Liège Centre & 1ère couronne :</strong> Liège (4000, 4020, 4030), Herstal, Seraing, Ans, Grâce-Hollogne</li>
              <li><span class="text-cyan">📍</span> <strong>Basse-Meuse & Vallée :</strong> Oupeye, Visé, Blegny, Chaudfontaine, Trooz, Beyne-Heusay</li>
              <li><span class="text-cyan">📍</span> <strong>Grande périphérie :</strong> Flémalle, Neupré, Aywaille, Verviers, Waremme, Huy</li>
            </ul>
            <a href="/locations/" class="btn-secondary mt-4" style="display:inline-block;">Voir toutes nos zones d'intervention</a>
          </div>
          <div class="map-visual" style="padding: 0;">
            <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2270.143942178439!2d5.617599676568288!3d50.637589471628516!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x287dbfc9c4468d03%3A0xbdbf84adcf689821!2sLynecares%20Plomberie%20Li%C3%A9geoise!5e1!3m2!1sen!2sbe!4v1782241787219!5m2!1sen!2sbe" width="100%" height="100%" style="border:0; min-height: 350px;" allowfullscreen="" loading="lazy" referrerpolicy="strict-origin-when-cross-origin"></iframe>
          </div>
        </div>
      </div>
    </section>

    <!-- E-E-A-T TEAM SECTION -->
    <section class="team-section py-5">
      <div class="container">
        <div class="team-grid glass" style="display: flex; gap: 30px; align-items: center; padding: 40px; border-left: 5px solid var(--orange); flex-wrap: wrap;">
          <div class="team-image" style="flex: 1; min-width: 300px; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 20px rgba(0,0,0,0.1);">
             <img src="https://images.unsplash.com/photo-1621905251189-08b45d6a269e?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="Plombier en intervention à Liège" style="width: 100%; height: auto; display: block;" />
          </div>
          <div class="team-content" style="flex: 1; min-width: 300px;">
            <h2 class="section-title text-left" style="text-align: left; margin-bottom: 20px;">Notre Équipe Locale</h2>
            <p style="color: #475569; font-size: 1.1rem; line-height: 1.6; margin-bottom: 20px;">Lynecares est une entreprise locale liégeoise spécialisée en plomberie et chauffage. Nous nous déplaçons directement chez vous, sans sous-traitance opaque, garantissant un suivi rigoureux et un travail aux normes de la Région Wallonne.</p>
            <div class="certifications-visual" style="display: flex; gap: 15px; align-items: center; background: #f8fafc; padding: 15px; border-radius: 8px;">
               <div style="font-size: 2.5rem;">✅</div>
               <div>
                 <strong style="color: var(--navy); display: block;">Travail dans les normes belges</strong>
                 <span style="color: #64748b; font-size: 0.9rem;">Nous garantissons que toutes nos réparations et installations respectent les normes en vigueur.</span>
               </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SEO CONTENT EXPANSION (Why Choose Us) -->
    <section class="seo-content py-5">
      <div class="container glass" style="padding: 40px; text-align: left;">
        <h2 class="section-title text-center" style="margin-bottom: 30px;">Pourquoi choisir notre entreprise de plomberie à Liège ?</h2>
        <div class="seo-text" style="color: #475569; line-height: 1.8; font-size: 1.05rem;">
          <p>Lynecares est avant tout une entreprise locale liégeoise. Notre équipe de techniciens se tient constamment informée des normes sanitaires et environnementales de la Région Wallonne pour vous assurer une conformité et une sécurité totales.</p>
          
          <p class="mt-3">Face à une urgence plomberie, trouver un <strong>plombier fiable à Liège</strong> peut s'avérer stressant. Chez Lynecares, nous privilégions la clarté et l'honnêteté : devis avant intervention, explication précise de la panne, et outillage professionnel (caméras d'inspection endoscopiques, furets mécaniques, hydrocureuses). Cela nous permet de poser un diagnostic rapide sans démontage inutile.</p>

          <p class="mt-3">Au-delà du dépannage d'urgence, nous vous accompagnons dans vos projets de <a href="/services/renovation-salle-de-bain-liege/" class="text-cyan">rénovation de salle de bain</a> et de remplacement de chaudière. Nous vous guidons sur les choix de robinetterie et le respect des normes, avec un engagement strict : <strong>un travail soigné, des finitions durables et un chantier nettoyé.</strong></p>
          <div class="text-center mt-5">
            <a href="/blog/" class="btn-secondary">Consultez nos conseils et guides sur le Blog</a>
          </div>
        </div>
      </div>
    </section>

    <section class="faq-section container py-5">
      <h2 class="section-title">FAQ : Plombier à Liège</h2>
      <div class="faq-grid">
        <div class="faq-item glass">
          <h3>Quel est le délai d'intervention pour une urgence ?</h3>
          <p>Le délai moyen d'intervention en cas d'urgence à Liège est d'<strong>environ 30 minutes selon la disponibilité et votre localisation</strong>. Notre service d'astreinte est actif <strong>24h/24 et 7j/7</strong> pour sécuriser votre domicile.</p>
        </div>
        <div class="faq-item glass">
          <h3>Combien coûte un dépannage de plomberie ?</h3>
          <p>Nos tarifs sont 100% transparents. Le technicien analyse la situation sur place et fournit un devis exact avant tout début de travaux. Consultez notre guide complet sur les <a href="/blog/tarif-prix-plombier-liege-depannage/" class="text-cyan">tarifs d'un plombier à Liège</a>.</p>
        </div>
        <div class="faq-item glass">
          <h3>Comment déboucher une canalisation sans casse ?</h3>
          <p>Nous privilégions l'inspection par caméra vidéo et l'hydrocurage haute pression. Ces techniques nettoient en profondeur le conduit sans produit chimique corrosif ni démolition.</p>
        </div>
      </div>
    </section>

    <section class="cta py-5">
      <div class="container cta-container glass">
        <h2>Une Urgence Plomberie à Liège ?</h2>
        <p>Notre équipe est joignable 24h/24 et 7j/7 pour intervenir rapidement à votre domicile.</p>
        <a href="tel:0466265895" class="btn-primary cta-btn">☎ Appeler l'assistance (0466 26 58 95)</a>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    align-items: center;
    position: relative;
    padding-top: 80px;
  }

  .hero-box {
    max-width: 760px;
    padding: 40px;
    animation: slideUp 0.8s ease-out;
  }

  .badge {
    background-color: var(--orange);
    color: white;
    padding: 6px 12px;
    border-radius: 20px;
    font-size: 0.85rem;
    font-weight: 700;
    text-transform: uppercase;
    display: inline-block;
    margin-bottom: 20px;
  }

  .hero h1 {
    font-size: 3.2rem;
    line-height: 1.15;
    margin-bottom: 15px;
  }

  .highlight {
    color: var(--cyan);
  }

  .hero-intro {
    font-size: 1.15rem;
    margin-bottom: 20px;
    color: #334155;
    line-height: 1.5;
  }

  .direct-answer-box {
    background: rgba(255, 255, 255, 0.92);
    border-left: 4px solid var(--orange);
    border-radius: 8px;
    padding: 16px 20px;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    margin-bottom: 25px;
  }

  .answer-grid {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .answer-item {
    font-size: 0.95rem;
    line-height: 1.4;
    color: #1e293b;
  }

  .answer-label {
    font-weight: 700;
    color: var(--navy);
    margin-right: 6px;
  }

  .answer-val {
    color: #475569;
  }

  .hero-btns {
    display: flex;
    gap: 15px;
    flex-wrap: wrap;
  }

  .call-btn {
    background-color: var(--orange);
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
    margin-top: -60px;
    position: relative;
    z-index: 10;
  }

  .feature-card {
    padding: 30px;
    text-align: center;
    transition: transform 0.3s ease;
  }

  .feature-card:hover {
    transform: translateY(-10px);
  }

  .feature-card .icon {
    font-size: 3rem;
    margin-bottom: 15px;
  }

  .services-preview {
    background-color: white;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 30px;
  }

  .service-item {
    padding: 40px;
    border-top: 5px solid var(--cyan);
  }

  .read-more {
    display: inline-block;
    margin-top: 15px;
    font-weight: 600;
  }

  .cta-container {
    background: linear-gradient(135deg, var(--navy), #2a4175);
    color: white;
    text-align: center;
    padding: 60px 40px;
    border: none;
  }

  .cta-container h2 {
    color: white;
  }

  .cta-btn {
    background-color: var(--orange);
    font-size: 1.2rem;
    padding: 15px 40px;
    margin-top: 20px;
  }

  @keyframes slideUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2.5rem; }
    .features { margin-top: 40px; }
  }

  .faq-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .faq-item {
    padding: 30px;
    border-left: 4px solid var(--orange);
  }

  .faq-item h3 {
    color: var(--navy);
    margin-bottom: 15px;
    font-size: 1.1rem;
  }

  .faq-item p {
    color: #475569;
    margin: 0;
  }

  /* NEW SECTIONS STYLES */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
  }

  .stat-box {
    padding: 30px 20px;
    text-align: center;
    border-top: 4px solid var(--orange);
  }

  .stat-number {
    display: block;
    font-size: 3rem;
    font-weight: 800;
    color: var(--navy);
    line-height: 1;
    margin-bottom: 10px;
  }

  .stat-number small {
    font-size: 1.2rem;
    color: var(--cyan);
  }

  .stat-label {
    font-weight: 600;
    color: #475569;
  }

  .certifications-banner {
    padding: 30px;
  }

  .certifications-banner h3 {
    color: var(--navy);
    margin-bottom: 20px;
  }

  .cert-logos {
    display: flex;
    justify-content: center;
    gap: 30px;
    flex-wrap: wrap;
  }

  .cert-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    color: var(--navy);
  }

  .cert-icon {
    font-size: 2.5rem;
  }

  .bg-light {
    background-color: white;
  }

  .testimonials-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 30px;
  }

  .review-card {
    padding: 30px;
    border-left: 4px solid var(--cyan);
  }

  .review-header {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 15px;
  }

  .avatar {
    width: 50px;
    height: 50px;
    background-color: var(--navy);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    font-weight: bold;
  }

  .review-card p {
    font-style: italic;
    color: #475569;
    margin-bottom: 15px;
  }

  .review-service {
    font-size: 0.85rem;
    color: var(--orange);
    font-weight: 600;
  }

  .map-flex {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 40px;
    align-items: center;
    background-color: white;
    border-top: 4px solid var(--navy);
  }

  .area-list {
    list-style: none;
    padding: 0;
  }

  .area-list li {
    padding: 10px 0;
