---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Plombier urgence Liège 24h/24 | Lynecares" description="Urgence plomberie à Liège : fuite, canalisation, WC ou chauffe-eau. Appelez Lynecares au 0466 26 58 95 pour vérifier la disponibilité.">
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.plomberieliegeoise.be/services/urgences-plomberie/#service",
    "name": "Dépannage et Urgence Plomberie 24/7",
    "provider": {
      "@type": "Plumber",
      "@id": "https://www.plomberieliegeoise.be/#organization",
      "name": "Lynecares Plomberie Liégeoise"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Province de Liège"
    },
    "serviceType": "Emergency Plumbing Service",
    "description": "Dépannage d'urgence plomberie 24/7 à Liège. Intervention rapide pour fuites d'eau majeures, canalisations bouchées, inondations et pannes de chauffe-eau.",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR"
    }
  }
  </script>
  <Navbar />
  
  <main>
    <section class="page-header">
      <div class="container text-center">
        <h1>Plombier urgence à Liège, 24h/24 et 7j/7</h1>
        <p>Intervention rapide d'astreinte : fuites, WC bouchés, inondations et pannes sanitaires</p>
      </div>
    </section>

    <!-- WHAT'S INCLUDED -->
    <section class="container py-5">
      <h2 class="section-title">Nos interventions d'urgence plomberie</h2>
      <div class="glass p-5 mb-4">
        <ul class="values-list">
          <li><strong>Débouchage d'urgence 24h/24 :</strong> Intervention immédiate pour les WC débordants ou canalisations complètement obstruées.</li>
          <li><strong>Réparation fuite d'eau en urgence :</strong> Arrêt immédiat de la fuite et colmatage pour protéger votre habitation.</li>
          <li><strong>Intervention inondation & dégât des eaux :</strong> Sécurisation de l'alimentation électrique, pompage et mise hors d'eau.</li>
          <li><strong>Rupture de canalisation ou tuyau éclaté :</strong> Remplacement express de tronçon de tuyau (cuivre, Alpex, plomb) ou vanne d'arrêt défectueuse.</li>
          <li><strong>Panne d'eau chaude urgente :</strong> Diagnostic sur chauffe-eau ou boiler en panne avec sécurisation électrique ou gaz.</li>
        </ul>
      </div>
    </section>

    <!-- COMMON PROBLEMS -->
    <section class="problems-section py-5">
      <div class="container">
        <h2 class="section-title">Problèmes fréquents traités en astreinte</h2>
        <div class="problems-grid">
          <div class="problem-card glass">
            <h4>Inondation soudaine</h4>
            <p>Une canalisation lâche au milieu de la nuit, menaçant d'inonder vos sols et plafonds. Nous vous guidons par téléphone pour fermer la vanne d'arrêt générale avant notre arrivée.</p>
          </div>
          <div class="problem-card glass">
            <h4>Fuite de gaz suspecte</h4>
            <p>Une odeur de gaz anormale. Nous intervenons en urgence absolue pour détecter la source avec un nez électronique et sécuriser immédiatement la conduite.</p>
          </div>
          <div class="problem-card glass">
            <h4>WC bouché débordant</h4>
            <p>Refoulement des eaux usées empêchant toute utilisation des sanitaires. Dégagement immédiat au furet électrique ou hydrocurage.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- OUR PROCESS -->
    <section class="container py-5">
      <h2 class="section-title">Notre Processus d'Intervention d'Urgence</h2>
      <div class="process-steps">
        <div class="step glass">
          <div class="step-number">1</div>
          <h3>Triage Téléphonique Immédiat</h3>
          <p>Dès votre appel au <strong>0466 26 58 95</strong>, nous identifions le sinistre et vous donnons les consignes de sécurité (fermeture vanne, coupure disjoncteur).</p>
        </div>
        <div class="step glass">
          <div class="step-number">2</div>
          <h3>Arrivée sur les Lieux</h3>
          <p>Un technicien d'astreinte se déplace chez vous en environ 30 minutes selon la circulation et votre localisation dans le Grand Liège.</p>
        </div>
        <div class="step glass">
          <div class="step-number">3</div>
          <h3>Diagnostic & Devis Fixe</h3>
          <p>Avant tout travail, le technicien examine l'origine de la panne et vous présente un devis précis incluant le déplacement et la main-d'œuvre.</p>
        </div>
        <div class="step glass">
          <div class="step-number">4</div>
          <h3>Mise en Sécurité & Réparation</h3>
          <p>Nous réparons ou colmatons la panne avec du matériel professionnel agréé, puis testons l'étanchéité complète avant de quitter le chantier.</p>
        </div>
      </div>
    </section>

    <!-- WHY CHOOSE US & PRICING TRANSPARENCY -->
    <section class="why-us-section py-5">
      <div class="container text-center">
        <h2 class="section-title text-white">Politique tarifaire de nuit et de week-end</h2>
        <p class="text-white mb-4" style="max-width: 850px; margin-inline: auto; font-size: 1.1rem; line-height: 1.7;">
          L'urgence ne doit jamais être synonyme d'abus. Chez Lynecares, nous appliquons une politique de transparence stricte : le coût du déplacement d'urgence et le taux horaire de garde (soirée, nuit, samedi, dimanche et jours fériés) vous sont systématiquement confirmés par téléphone avant le départ de notre technicien. Nos camionnettes disposent des raccords et pièces de rechange courantes pour sécuriser votre domicile dès la visite.
        </p>
        <a href="tel:0466265895" class="btn-primary" style="font-size: 1.2rem; padding: 15px 35px;">📞 Appeler l'astreinte d'urgence : 0466 26 58 95</a>
      </div>
    </section>

    <!-- EMERGENCY & SERVICE AREA -->
    <section class="container py-5">
      <div class="info-split">
        <div class="emergency-info glass">
          <span class="huge-icon">🚑</span>
          <h3>Disponibilité Permanente</h3>
          <p>Notre pôle urgence est opérationnel <strong>24 heures sur 24, 7 jours sur 7</strong>, sans interruption.</p>
          <ul class="values-list" style="text-align: left;">
            <li>Intervention sur canalisations gelées (découvrez <a href="/blog/comment-degeler-tuyaux-geles-hiver-liege/" class="text-cyan">comment dégeler sans éclater</a>)</li>
            <li>Recherche de fuite non destructive et colmatage</li>
          </ul>
          <a href="tel:0466265895" class="btn-primary mt-3">Urgence 24/7 : 0466 26 58 95</a>
        </div>
        <div class="area-info glass">
          <span class="huge-icon">📍</span>
          <h3>Zones d'Astreinte Rapide</h3>
          <p>Nous couvrons l'intégralité de la province de Liège : Liège Ville (4000, 4020, 4030), Seraing, Herstal, Ans, Flémalle, Chaudfontaine, Oupeye, Visé, Beyne-Heusay, Trooz, Aywaille...</p>
        </div>
      </div>
    </section>

    <!-- FAQS -->
    <section class="faq-section container py-5">
      <h2 class="section-title">Foire Aux Questions (FAQ) - Urgence Plomberie</h2>
      <div class="faq-grid">
        <div class="faq-item glass">
          <h3>Quel est le délai d'arrivée en cas d'urgence ?</h3>
          <p>Le délai moyen d'arrivée est d'environ 30 minutes pour l'agglomération liégeoise, selon l'état du trafic routier et la disponibilité des équipes d'astreinte.</p>
        </div>
        <div class="faq-item glass">
          <h3>Comment sont calculés les frais de nuit et de week-end ?</h3>
          <p>Conformément aux barèmes du secteur en Belgique, une majoration légale s'applique sur la main-d'œuvre en dehors des heures ouvrables (+50% en soirée et samedi, +100% la nuit et dimanche). Le forfait de déplacement reste fixe et vous est communiqué au préalable.</p>
        </div>
        <div class="faq-item glass">
          <h3>Que faire en attendant l'arrivée du plombier ?</h3>
          <p>Fermez immédiatement la vanne d'arrêt générale (souvent située près du compteur d'eau), coupez l'électricité de la zone si de l'eau s'est infiltrée près des prises, et épongez pour limiter les dégâts matériels.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @import '../../styles/global.css';

  .page-header {
    background-color: var(--navy);
    color: white;
    padding: 150px 0 80px;
    text-align: center;
  }

  .page-header h1 { color: white; font-size: 3rem; }
  .page-header p { color: var(--cyan); font-size: 1.2rem; }
  .p-5 { padding: 40px; }

  .values-list { list-style: none; padding: 0; }
  .values-list li { padding: 10px 0 10px 30px; position: relative; color: #475569; }
  .values-list li::before { content: '✔️'; position: absolute; left: 0; top: 10px; }

  .problems-section { background-color: white; }
  .problems-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
  .problem-card { padding: 30px; border-left: 4px solid var(--orange); }
  .problem-card h4 { color: var(--navy); font-size: 1.2rem; }

  .process-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
  .step { padding: 30px; text-align: center; }
  .step-number { width: 50px; height: 50px; background-color: var(--navy); color: white; font-size: 1.5rem; font-weight: bold; display: flex; align-items: center; justify-content: center; border-radius: 50%; margin: 0 auto 20px; }
  .step h3 { color: var(--cyan); font-size: 1.1rem; }

  .why-us-section { background: linear-gradient(135deg, var(--navy), #2a4175); color: white; }
  .text-white { color: white !important; }

  .info-split { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; }
  .emergency-info, .area-info { padding: 40px; text-align: center; }
  .huge-icon { font-size: 4rem; margin-bottom: 20px; display: block; }

  .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .faq-item { padding: 30px; }
  .faq-item h3 { color: var(--navy); font-size: 1.1rem; margin-bottom: 10px; }
</style>
