---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Débouchage Liège | Canalisation, WC et évier | Lynecares" description="Débouchage canalisation à Liège : WC, évier, douche et égout. Intervention d'urgence avec furet et hydrocureuse haute pression. Devis clair.">
  <script type="application/ld+json" slot="head">
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": "https://www.plomberieliegeoise.be/services/debouchage/#service",
    "name": "Débouchage de Canalisation à Liège",
    "provider": {
      "@type": "Plumber",
      "@id": "https://www.plomberieliegeoise.be/#organization",
      "name": "Lynecares Plomberie Liégeoise"
    },
    "areaServed": {
      "@type": "AdministrativeArea",
      "name": "Province de Liège"
    },
    "serviceType": "Débouchage et Hydrocurage",
    "description": "Service professionnel de débouchage d'urgence à Liège : WC bouché, évier, baignoire, égout principal, hydrocurage haute pression et inspection par caméra vidéo.",
    "offers": {
      "@type": "Offer",
      "priceCurrency": "EUR"
    }
  }
  </script>
  <Navbar />
  
  <main>
    <section class="page-header">
      <div class="container text-center">
        <h1>Débouchage de canalisation à Liège</h1>
        <p>Intervention rapide 7j/7 pour WC, éviers, douches et égouts extérieurs avec hydrocureuse et caméra</p>
      </div>
    </section>

    <!-- WHAT'S INCLUDED: DETAILED SECTIONS -->
    <section class="container py-5">
      <h2 class="section-title">Nos solutions spécialisées de débouchage</h2>
      <div class="services-grid mb-4">
        <div class="service-item glass">
          <h3>🚽 Débouchage WC & Toilettes</h3>
          <p>Papier compacté, lingettes ou objet coincé provoquant un débordement. Dégagement immédiat au furet électrique professionnel sans rayer la céramique.</p>
        </div>
        <div class="service-item glass">
          <h3>🍳 Débouchage Évier & Cuisine</h3>
          <p>Graisses de cuisson solidifiées, restes alimentaires et dépôts de savon. Nettoyage mécanique du siphon et de la colonne d'évacuation.</p>
        </div>
        <div class="service-item glass">
          <h3>🚿 Débouchage Douche & Baignoire</h3>
          <p>Amas de cheveux et résidus de savon bloquant la bonde ou le siphon de sol. Rétablissement immédiat de l'écoulement normal.</p>
        </div>
        <div class="service-item glass">
          <h3>🏡 Débouchage d'Égout Principal & Chambre de Visite</h3>
          <p>Refoulement général vers la cave ou le sous-sol. Désobstruction des conduites enterrées et raccordement au réseau public de voirie.</p>
        </div>
        <div class="service-item glass">
          <h3>📹 Inspection Caméra Endoscopique</h3>
          <p>Passage d'une caméra étanche HD pour visualiser l'intérieur du tuyau, mesurer la distance exacte du bouchon et repérer les racines ou cassures.</p>
        </div>
        <div class="service-item glass">
          <h3>💧 Hydrocurage Haute Pression (300 Bars)</h3>
          <p>Nettoyage en profondeur des parois par injection d'eau sous pression. Élimine totalement le tartre et la graisse accumulée sans abîmer le PVC ou le grès.</p>
        </div>
      </div>
    </section>

    <!-- OUR PROCESS -->
    <section class="container py-5">
      <h2 class="section-title">Comment se déroule notre intervention de débouchage ?</h2>
      <div class="process-steps">
        <div class="step glass">
          <div class="step-number">1</div>
          <h3>Diagnostic Initial</h3>
          <p>Nous vérifions si le bouchon est localisé (un seul appareil) ou général (tous les sanitaires de la maison refoulent).</p>
        </div>
        <div class="step glass">
          <div class="step-number">2</div>
          <h3>Méthode Adaptée</h3>
          <p>Sélection de l'outil approprié : furet mécanique rotatif pour les petits diamètres, ou buse d'hydrocurage pour les colonnes principales.</p>
        </div>
        <div class="step glass">
          <div class="step-number">3</div>
          <h3>Débouchage & Curage</h3>
          <p>Broyage ou évacuation du bouchon sans produit chimique corrosif afin de préserver vos conduites et l'environnement.</p>
        </div>
        <div class="step glass">
          <div class="step-number">4</div>
          <h3>Contrôle d'Écoulement</h3>
          <p>Test avec un fort volume d'eau pour vérifier la fluidité totale et remise d'un rapport pour votre assurance si nécessaire.</p>
        </div>
      </div>
    </section>

    <!-- TRANSPARENT PRICING RULES -->
    <section class="container py-5">
      <div class="glass p-5">
        <h2>Règles tarifaires claires pour votre débouchage</h2>
        <p>Un problème de canalisation ne doit pas donner lieu à des devis abusifs. Chez Lynecares, nos tarifs sont arrêtés avant toute opération :</p>
        <ul class="values-list">
          <li><strong>Forfait débouchage simple :</strong> Comprend le déplacement et l'intervention mécanique classique.</li>
          <li><strong>Hydrocurage haute pression ou caméra :</strong> Si la complexité du réseau l'exige, le coût vous est annoncé avant toute manipulation.</li>
          <li><strong>Pas de surprise finale :</strong> Consultez notre guide des <a href="/blog/tarif-prix-plombier-liege-depannage/" class="text-cyan">prix et tarifs plombier à Liège</a> pour connaître les moyennes du marché.</li>
        </ul>
      </div>
    </section>

    <!-- EMERGENCY & SERVICE AREA -->
    <section class="container py-5">
      <div class="info-split">
        <div class="emergency-info glass">
          <span class="huge-icon">🚑</span>
          <h3>Urgence Débouchage 24/7</h3>
          <p>Vos toilettes débordent ou l'eau remonte dans votre bac de douche ? Contactez-nous pour une intervention d'urgence immédiate.</p>
          <a href="tel:0466265895" class="btn-primary mt-3">📞 0466 26 58 95</a>
        </div>
        <div class="area-info glass">
          <span class="huge-icon">📍</span>
          <h3>Périmètre d'Intervention</h3>
          <p>Nous intervenons dans toute la province de Liège : Liège Ville, Seraing, Herstal, Ans, Flémalle, Oupeye, Chaudfontaine, Visé, Beyne-Heusay, Trooz...</p>
          <a href="/services/urgences-plomberie/" class="btn-secondary mt-3">Voir les urgences plomberie</a>
        </div>
      </div>
    </section>

    <!-- FAQS -->
    <section class="faq-section container py-5">
      <h2 class="section-title">Foire Aux Questions - Débouchage Canalisations</h2>
      <div class="faq-grid">
        <div class="faq-item glass">
          <h3>Pourquoi éviter les déboucheurs chimiques du commerce ?</h3>
          <p>Les déboucheurs à base de soude caustique ou d'acide sulfurique stagnent sur le bouchon, chauffent et peuvent faire fondre les raccords PVC tout en dégageant des vapeurs toxiques nocives pour la santé.</p>
        </div>
        <div class="faq-item glass">
          <h3>L'assurance habitation prend-elle en charge le débouchage ?</h3>
          <p>Si le bouchon a causé un dégât des eaux chez vous ou chez un voisin, l'assurance prend en charge les dommages matériels. Notre facture détaillée peut être transmise à votre assureur.</p>
        </div>
        <div class="faq-item glass">
          <h3>L'hydrocurage risque-t-il d'abîmer mes tuyaux ?</h3>
          <p>Non, les buses rotatives adaptent la pression et le jet d'eau rétroactif pour décoller les matières organiques sans agresser la paroi structurelle des conduites.</p>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  @import '../../styles/global.css';

  .page-header { background-color: var(--navy); color: white; padding: 150px 0 80px; text-align: center; }
  .page-header h1 { color: white; font-size: 3rem; }
  .page-header p { color: var(--cyan); font-size: 1.2rem; }
  .p-5 { padding: 40px; }

  .values-list { list-style: none; padding: 0; }
  .values-list li { padding: 10px 0 10px 30px; position: relative; color: #475569; }
  .values-list li::before { content: '✔️'; position: absolute; left: 0; top: 10px; }

  .problems-section { background-color: white; }
  .problems-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 30px; }
  .problem-card { padding: 30px; border-left: 4px solid var(--orange); }
  .problem-card h4 { color: var(--navy); font-size: 1.2rem; }

  .process-steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 20px; }
  .step { padding: 30px; text-align: center; }
  .step-number { width: 50px; height: 50px; background-color: var(--navy); color: white; font-size: 1.5rem; font-weight: bold; display: flex; align-items: center; justify-content: center; border-radius: 50%; margin: 0 auto 20px; }
  .step h3 { color: var(--cyan); font-size: 1.1rem; }

  .why-us-section { background: linear-gradient(135deg, var(--navy), #2a4175); color: white; }
  .text-white { color: white !important; }

  .info-split { display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 30px; }
  .emergency-info, .area-info { padding: 40px; text-align: center; }
  .huge-icon { font-size: 4rem; margin-bottom: 20px; display: block; }

  .faq-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; }
  .faq-item { padding: 30px; }
  .faq-item h3 { color: var(--navy); font-size: 1.1rem; margin-bottom: 10px; }
</style>
