---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact plombier Liège 24/7 | Lynecares" description="Contactez Lynecares pour tout dépannage de plomberie ou devis à Liège et province. Téléphone 0466 26 58 95 disponible 24/7, devis gratuit.">
  <Navbar />
  
  <main>
    <section class="page-header">
      <div class="container text-center">
        <h1>Contactez votre plombier à Liège</h1>
        <p>Une urgence 24/7 ou un devis pour vos sanitaires et chauffage ? Notre équipe locale vous répond rapidement.</p>
      </div>
    </section>

    <section class="container py-5">
      <div class="contact-wrapper">
        <div class="contact-info glass p-5">
          <h2>Nos Coordonnées</h2>
          <p>N'hésitez pas à nous contacter pour toute demande de devis ou d'intervention. Notre équipe d'astreinte est joignable de jour comme de nuit.</p>
          
          <div class="faq-item glass">
            <h3>Proposez-vous des devis gratuits ?</h3>
            <p>Oui, nous proposons des devis gratuits pour toutes les nouvelles installations (salle de bain, chaudière). Lisez notre guide sur les <a href="/blog/devis-plomberie-points-a-verifier-liege/" class="text-cyan">5 points à vérifier avant de signer un devis</a>.</p>
          </div>

          <div class="info-item">
            <div class="icon">📍</div>
            <div>
              <h3>Adresse de l'Atelier</h3>
              <p><a href="https://maps.app.goo.gl/jszbVzeLu9fDEsEr9" target="_blank" rel="noopener noreferrer" style="color: inherit; text-decoration: none;">188 Rue de Bois-de-Breux<br>4020 Liège, Belgique</a></p>
            </div>
          </div>
          
          <div class="info-item">
            <div class="icon">📞</div>
            <div>
              <h3>Téléphone</h3>
              <p><a href="tel:0466265895">0466 26 58 95</a><br><small>Disponible 24h/24 et 7j/7 pour les urgences</small></p>
            </div>
          </div>
          
          <div class="info-item">
            <div class="icon">✉️</div>
            <div>
              <h3>Email</h3>
              <p><a href="mailto:contact@plomberieliegeoise.be">contact@plomberieliegeoise.be</a></p>
            </div>
          </div>

          <div class="info-item">
            <div class="icon">⏱️</div>
            <div>
              <h3>Horaires d'Ouverture</h3>
              <p>Permanence d'urgence : <strong>24/7</strong><br>Bureaux & devis : Lun-Ven 8h00 - 18h00</p>
            </div>
          </div>
        </div>

        <div class="contact-form glass p-5">
          <h2>Envoyez-nous un message</h2>
          <form action="https://formsubmit.co/midebzn@gmail.com" method="POST" id="contactForm">
            <input type="text" name="_honey" style="display:none" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_subject" value="Nouveau message depuis la page Contact Lynecares !" />
            <input type="hidden" name="_next" value="https://www.plomberieliegeoise.be/contact/" />

            <div class="form-group">
              <label for="name">Nom complet *</label>
              <input type="text" id="name" name="name" required placeholder="Votre nom et prénom">
            </div>
            
            <div class="form-group">
              <label for="phone">Numéro de téléphone *</label>
              <input type="tel" id="phone" name="phone" required placeholder="04xx xx xx xx">
            </div>
            
            <div class="form-group">
              <label for="message">Description de votre demande *</label>
              <textarea id="message" name="message" rows="5" required placeholder="Décrivez votre besoin (dépannage urgent, rénovation de salle de bain, entretien chaudière...)"></textarea>
            </div>
            
            <button type="submit" class="btn-primary w-100">Envoyer ma demande</button>
          </form>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    background-color: var(--navy);
    color: white;
    padding: 150px 0 80px;
    text-align: center;
  }

  .page-header h1 {
    color: white;
    font-size: 3rem;
  }

  .page-header p {
    color: var(--cyan);
    font-size: 1.2rem;
  }

  .p-5 { padding: 40px; }

  .contact-wrapper {
    display: flex;
    gap: 40px;
    flex-wrap: wrap;
  }

  .contact-info, .contact-form {
    flex: 1;
    min-width: 300px;
  }

  .contact-info h2, .contact-form h2 {
    color: var(--navy);
    margin-bottom: 25px;
  }

  .info-item {
    display: flex;
    gap: 15px;
    margin-top: 25px;
  }

  .info-item .icon {
    font-size: 1.8rem;
    background: rgba(0, 168, 204, 0.1);
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }

  .info-item h3 {
    margin: 0 0 5px 0;
    font-size: 1.1rem;
  }

  .info-item p {
    margin: 0;
    color: #475569;
  }

  .social-btn {
    display: inline-block;
    padding: 8px 16px;
    background-color: var(--navy);
    color: white;
    border-radius: 6px;
    margin-right: 10px;
    font-size: 0.9rem;
  }

  .social-btn:hover {
    background-color: var(--cyan);
    color: white;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
    color: var(--navy);
  }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%;
    padding: 12px;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    font-family: inherit;
    font-size: 1rem;
    background-color: rgba(255, 255, 255, 0.9);
    transition: border-color 0.3s;
  }

  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--cyan);
    box-shadow: 0 0 0 3px rgba(0, 168, 204, 0.1);
  }

  .w-100 {
    width: 100%;
  }

  @media (max-width: 768px) {
    .contact-wrapper { flex-direction: column; }
  }
</style>
